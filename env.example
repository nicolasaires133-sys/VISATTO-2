# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).

# Banco de dados Postgres (Neon). Sem isso, em desenvolvimento local o app usa um banco embutido em ./.data
DATABASE_URL=

# Armazenamento de fotos e modelos 3D (Vercel Blob). Criado automaticamente ao ligar o Blob no projeto da Vercel.
BLOB_READ_WRITE_TOKEN=

# Garçom de IA (console.anthropic.com > API Keys). Sem ela o garçom funciona em "modo demonstração".
ANTHROPIC_API_KEY=

# Criação de pratos 3D por IA a partir de fotos (meshy.ai > API). Opcional: sem ela o dono ainda pode enviar um arquivo 3D escaneado.
MESHY_API_KEY=

# Frase secreta longa e aleatória para proteger os logins (obrigatório em produção)
AUTH_SECRET=

# Chave para criar o restaurante de demonstração: abra /api/setup-demo?chave=ESSA_CHAVE uma vez
SETUP_KEY=

# Opcionais
# AI_MODEL=claude-haiku-5-5          # modelo do garçom (rápido e barato)
# AI_VISION_MODEL=claude-sonnet-5-5  # modelo que lê fotos de cardápio
# APP_TIMEZONE=America/Sao_Paulo

# Opcional e pago: a IA da Anthropic dá uma segunda opinião sobre o que é o prato no escâner.
# Deixe vazio para o escâner ser 100% grátis (o reconhecimento pela imagem já roda de graça no próprio site).
SCAN_IA_PAGA=
